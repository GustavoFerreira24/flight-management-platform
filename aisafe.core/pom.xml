<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>isep</groupId>
        <artifactId>aisafe</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>aisafe.core</artifactId>
    <packaging>jar</packaging>

    <properties>
        <flightPlan.dsl.file>${maven.multiModuleProjectDirectory}/docs/us_83/valid-flight-plan.fpl</flightPlan.dsl.file>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.2</version>
                <configuration>
                    <sourceDirectory>${basedir}/src/main/antlr4/isep/aisafe/flightplan/importer/dsl</sourceDirectory>
                    <visitor>true</visitor>
                    <arguments>
                        <argument>-visitor</argument>
                        <argument>-package</argument>
                        <argument>isep.aisafe.flightplan.importer.dsl</argument>
                    </arguments>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-antlr-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/antlr4</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>isep.aisafe.flightplan.importer.dsl.FlightPlanDslCli</mainClass>
                    <arguments>
                        <argument>${flightPlan.dsl.file}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
