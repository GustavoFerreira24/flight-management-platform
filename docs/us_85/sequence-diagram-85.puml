@startuml
title US085 - Test / Validate Flight Plan

actor Pilot
boundary TestFlightPlanUI as UI
control TestFlightPlanController as Controller
control AisafeAuthorizationService as Authz
database FlightPlanRepository as Repository
entity FlightPlan
entity Flight
entity FlightRoute
entity Aircraft
entity Pilot as PilotAggregate

Pilot -> UI : Select Test / Validate Flight Plan
UI -> Controller : authenticatedPilotFlightPlans()
Controller -> Authz : ensureAuthenticatedUserHasAnyOf(FLIGHT_PLAN_MANAGEMENT)
Controller -> Authz : authenticatedEmail()
Controller -> Repository : findAll()
Repository --> Controller : flight plans
Controller --> UI : owned testable flight plans
UI --> Pilot : Show flight plan list

Pilot -> UI : Select flight plan
UI -> Controller : testFlightPlan(identifier)

Controller -> Authz : ensureAuthenticatedUserHasAnyOf(FLIGHT_PLAN_MANAGEMENT)
Controller -> Repository : findByIdentifier(identifier)
Repository --> Controller : FlightPlan
Controller -> Authz : authenticatedEmail()
Controller -> FlightPlan : pilot().email()
Controller -> FlightPlan : status(), canBeTested()

Controller -> FlightPlan : flight()
FlightPlan --> Controller : Flight
Controller -> Flight : route()
Flight --> Controller : FlightRoute
Controller -> FlightRoute : isActive(), company()

Controller -> FlightPlan : aircraft()
FlightPlan --> Controller : Aircraft
Controller -> Aircraft : canBeUsedForFlights(), company(), aircraftModel(), engineModel()

Controller -> FlightPlan : pilot()
FlightPlan --> Controller : PilotAggregate
Controller -> PilotAggregate : pilotStatus(), companyIATACode(), certifiedAircraftModelsDesignators()

alt operational validation fails
    Controller -> FlightPlan : reject()
    Controller -> Repository : save(FlightPlan)
    Repository --> Controller : saved FlightPlan
    Controller --> UI : failure(REJECTED, messages)
    UI --> Pilot : Show validation errors
else operational validation succeeds
    Controller -> FlightPlan : validate()
    Controller -> Repository : save(FlightPlan)
    Repository --> Controller : saved FlightPlan
    Controller --> UI : success(VALIDATED, report)
    UI --> Pilot : Show validation report
end

@enduml
