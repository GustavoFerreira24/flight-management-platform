@startuml
title US085 - Test / Validate Flight Plan

class TestFlightPlanUI {
    - controller : TestFlightPlanController
    - scanner : Scanner
    + show() : void
}

class TestFlightPlanController {
    - authz : AisafeAuthorizationService
    - flightPlanRepository : FlightPlanRepository
    + execute() : void
    + authenticatedPilotFlightPlans() : List<FlightPlan>
    + testFlightPlan(flightPlanIdentifierText : String) : TestFlightPlanResult
}

class TestFlightPlanResult {
    - successful : boolean
    - status : FlightPlanStatus
    - messages : List<String>
    + isSuccessful() : boolean
    + status() : FlightPlanStatus
    + messages() : List<String>
}

interface FlightPlanRepository {
    + findAll() : Iterable<FlightPlan>
    + findByIdentifier(identifier : FlightPlanIdentifier) : Optional<FlightPlan>
    + save(flightPlan : FlightPlan) : FlightPlan
}

class FlightPlan {
    - status : FlightPlanStatus
    + identity() : FlightPlanIdentifier
    + flight() : Flight
    + flightDesignator() : String
    + aircraft() : Aircraft
    + aircraftRegistration() : String
    + pilot() : Pilot
    + pilotIdentifier() : String
    + fuelQuantity() : FuelQuantity
    + weatherDataCount() : int
    + hasWeatherData() : boolean
    + canBeTested() : boolean
    + validate() : void
    + reject() : void
    + status() : FlightPlanStatus
}

enum FlightPlanStatus {
    DRAFT
    UNDER_VALIDATION
    VALIDATED
    REJECTED
}

class Flight {
    + route() : FlightRoute
}

class FlightRoute {
    + isActive() : boolean
    + company() : AirTransportCompany
}

class Aircraft {
    + canBeUsedForFlights() : boolean
    + company() : AirTransportCompany
    + aircraftModel() : AircraftModel
    + engineModel() : EngineModel
}

class Pilot {
    + pilotStatus() : PilotStatus
    + companyIATACode() : IATACode
    + certifiedAircraftModelsDesignators() : Set<AircraftModelDesignator>
    + email() : EmailAddress
}

TestFlightPlanUI --> TestFlightPlanController
TestFlightPlanController --> AisafeAuthorizationService
TestFlightPlanController --> FlightPlanRepository
TestFlightPlanController --> TestFlightPlanResult
FlightPlanRepository --> FlightPlan
FlightPlan --> FlightPlanStatus
FlightPlan --> Flight
FlightPlan --> Aircraft
FlightPlan --> Pilot
Flight --> FlightRoute

@enduml
