@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

class AircraftModel <<Aggregate Root>> {
        name
        type <<enum>>
        motorization <<enum>>
        maxRange
        emptyWeight
        MTOW
        MZFW
        maxFuelCapacity
        serviceCeiling
        cruiseSpeed
        wingArea
        dragCoefficient
        liftCoefficient
    }

    class AircraftModelDesignator <<Value Object>> {
        value
    }

    class AircraftVariant <<Entity>> {
        variantId
    }

    AircraftModel "1" --> "1" AircraftModelDesignator
    AircraftModel "1" *-- "0..*" AircraftVariant
}

@enduml