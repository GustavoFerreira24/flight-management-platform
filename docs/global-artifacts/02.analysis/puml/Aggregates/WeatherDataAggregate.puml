@startuml
skinparam {
    BackgroundColor white
    RoundCorner 8
    Shadowing false
    Handwritten false
    ClassAttributeIconSize 0

    ClassBackgroundColor white
    ClassBorderColor #495057
    ClassFontSize 12

    ClassBackgroundColor<<Aggregate Root>> #E7F5FF
    ClassBorderColor<<Aggregate Root>> #228BE6

    ClassBackgroundColor<<Value Object>> #FFF9DB
    ClassBorderColor<<Value Object>> #FAB005

    ClassBackgroundColor<<Entity>> #F3F0FF
    ClassBorderColor<<Entity>> #7950F2
}
hide circle
hide methods

class WeatherData <<Aggregate Root>> {
          day
    }

    class WeatherMeasurement <<Value Object>> {
        value
        altitude
    }

    class WeatherProvider <<Entity>> {
        name
    }

    class WeatherProviderType <<Value Object>> {
        value
    }

    class WeatherParameter <<Value Object>> {
        name
    }

    class WeatherUnit <<Value Object>> {
        value
    }

    class Coordinates <<Value Object>> {
            latitude
            longitude
    }

    WeatherData --> WeatherProvider
    WeatherData *-- WeatherMeasurement
    WeatherMeasurement *-- Coordinates
    WeatherProvider *-- WeatherProviderType
    WeatherMeasurement *-- WeatherParameter
    WeatherParameter *-- WeatherUnit


@enduml