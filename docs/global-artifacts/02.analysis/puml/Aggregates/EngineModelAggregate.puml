@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

package "EngineModel Aggregate" {

    class EngineModel <<Aggregate Root>> {
        name
        type <<enum>>
        thrust
        fuelType
        TSFC
    }

    class EngineModelDesignator <<Value Object>> {
        value
    }

    EngineModel "1" --> "1" EngineModelDesignator

}

@enduml