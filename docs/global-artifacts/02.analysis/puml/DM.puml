skinparam {
    BackgroundColor white
    RoundCorner 8
    Shadowing false
    Handwritten false
    ClassAttributeIconSize 0
    PackageStyle frame
    linetype ortho

    PackageBackgroundColor #F8F9FA
    PackageBorderColor #ADB5BD

    ClassBackgroundColor white
    ClassBorderColor #495057
    ClassFontSize 12

    ClassBackgroundColor<<Aggregate Root>> #E7F5FF
    ClassBorderColor<<Aggregate Root>> #228BE6

    ClassBackgroundColor<<Value Object>> #FFF9DB
    ClassBorderColor<<Value Object>> #FAB005

    ClassBackgroundColor<<Entity>> #F3F0FF
    ClassBorderColor<<Entity>> #7950F2
}

hide circle
hide methods

package "Simulation Aggregate" {

    class Simulation <<Aggregate Root>> {
        timeRange
        safetyThreshold
    }

    class SimulationStatus <<Value Object>> {
        value
    }

    class FlightExecution <<Entity>> {

    }

    class FlightExecutionStatus <<Value Object>> {
        value
    }

    class Report <<Value Object>> {
        totalFlights
        result
        generatedAt
    }

    class SafetyViolation <<Value Object>> {
        timestamp
    }

    class SafetyViolationType <<Value Object>> {
        name
    }

    class SafetyViolationSeverity <<Value Object>> {
        value
    }


    class AircraftPosition <<Value Object>> {
        altitude
        velocity
        timestamp
    }
    class Coordinates <<Value Object>> {
        latitude
        longitude
    }

    Simulation *-- Report
    Simulation *-- SafetyViolation
    Simulation *-- FlightExecution
    Simulation *-- SimulationStatus
    SafetyViolation "1" --> "*" FlightExecution
    FlightExecution *-- AircraftPosition
    AircraftPosition *-- Coordinates
    FlightExecution *-- FlightExecutionStatus
    SafetyViolation *-- SafetyViolationType
    SafetyViolationType *-- SafetyViolationSeverity


}

package "FlightRoute Aggregate" {

    class FlightRoute <<Aggregate Root>> {
        deactivatedFrom
    }

    class RouteDesignator <<Value Object>> {
        value
    }

    class FlightRouteType <<Value Object>> {
        value
    }

    class FlightRouteStatus <<Value Object>> {
        value
    }

    FlightRoute *-- RouteDesignator
    FlightRoute *-- FlightRouteType
    FlightRoute *-- FlightRouteStatus


}

package "FlightPlan Aggregate" {

    class FlightPlan <<Aggregate Root>> {
    }

    class FlightPlanIdentifier <<Value Object>> {
        value
    }

    class FlightPlanStatus <<Value Object>> {
        value
    }

    class FuelQuantity <<Value Object>> {
        amount
    }

    class FuelUnit <<Value Object>> {
        value
    }

    FlightPlan *-- FuelQuantity
    FlightPlan *-- FlightPlanIdentifier
    FlightPlan *-- FlightPlanStatus
    FuelQuantity *-- FuelUnit

}

package "Airport Aggregate" {

    class Airport <<Aggregate Root>> {
        name
        town
        altitude
    }

    class Coordinates <<Value Object>> {
            latitude
            longitude
    }

    class Country <<Value Object>> {
       name
    }

    class IATACode <<Value Object>> {
        value
    }

    class ICAOCode <<Value Object>> {
       value
    }

    Airport *-- Coordinates
    Airport *-- Country
    Airport *-- IATACode
    Airport *-- ICAOCode

}

