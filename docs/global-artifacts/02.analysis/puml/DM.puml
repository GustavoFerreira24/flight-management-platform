@startuml
skinparam {
    BackgroundColor white
    RoundCorner 8
    Shadowing false
    Handwritten false
    ClassAttributeIconSize 0
    PackageStyle frame

    PackageBackgroundColor #F8F9FA
    PackageBorderColor #ADB5BD

    ClassBackgroundColor white
    ClassBorderColor #495057
    ClassFontSize 12

    ClassBackgroundColor<<Aggregate Root>> #E7F5FF
    ClassBorderColor<<Aggregate Root>> #228BE6

    ClassBackgroundColor<<Value Object>> #FFF9DB
    ClassBorderColor<<Value Object>> #FAB005

    ClassBackgroundColor<<Entity>> #F3F0FF
    ClassBorderColor<<Entity>> #7950F2
}

' Esconder elementos desnecessários
hide circle
hide methods

package "Simulation Aggregate" {
    class Simulation <<Aggregate Root>> {
        timeRange
        safetyThreshold
        status
    }

    class FlightExecution <<Entity>> {
        status <<enum>>
    }

    class Report <<Value Object>> {
        totalFlights
        result
        generatedAt
    }

    class SafetyViolation <<Value Object>> {
        timestamp
        severity
        type
    }

    class AircraftPosition <<Value Object>> {
        altitude
        velocity
        timestamp
    }
    class Coordinates <<Value Object>> {
        latitude
        longitude
    }

    Simulation *-- Report
    Simulation *-- SafetyViolation
    Simulation *-- FlightExecution
    SafetyViolation *-- AircraftPosition
    SafetyViolation "1" --> "*" FlightExecution
    FlightExecution "1" --> "*" AircraftPosition
    AircraftPosition *-- Coordinates


}

package "FlightRoute Aggregate" {

    class FlightRoute <<Aggregate Root>> {
        type <<enum>>
        status <<enum>>
        deactivatedFrom
    }

    class RouteDesignator <<Value Object>> {
        value
    }

    FlightRoute *-- RouteDesignator


}

package "FlightPlan Aggregate" {

    class FlightPlan <<Aggregate Root>> {
        status
        scheduledArrival
    }


    class FuelQty <<Value Object>> {
        amount
        unit <<enum>>
    }


    FlightPlan *-- FuelQty

}

package "Airport Aggregate" {

    class Airport <<Aggregate Root>> {
        name
        town
        altitude
    }

    class Coordinates <<Value Object>> {
            latitude
            longitude
    }

    class Country <<Value Object>> {
       name
    }

    class IATACode <<Value Object>> {
        value
    }

    class ICAOCode <<Value Object>> {
       value
    }

    Airport *-- Coordinates
    Airport *-- Country
    Airport *-- IATACode
    Airport *-- ICAOCode

}

package "AirControlArea Aggregate" {

    class AirControlArea <<Aggregate Root>> {
        name
    }

    class AirControlAreaCode <<Value Object>> {
        value
    }

    class GeographicBoundary <<Value Object>> {
        minLatitude
        maxLatitude
        minLongitude
        maxLongitude
    }

    AirControlArea *-- AirControlAreaCode
    AirControlArea *-- GeographicBoundary

}

package "AirTransportCompany Aggregate" {

    class AirTransportCompany <<Aggregate Root>> {
        name
    }

    class Country <<Value Object>> {
       name
    }

    class IATACode <<Value Object>> {
        value
    }

    class ICAOCode <<Value Object>> {
       value
    }

    AirTransportCompany *-- Country
    AirTransportCompany *-- IATACode
    AirTransportCompany *-- ICAOCode


}


package "User Aggregate" {

    class User <<Aggregate Root>> {
           name
           status <<enum>>
    }

    class EmailAddress <<Value Object>> {
        value
    }

    class PhoneNumber <<Value Object>> {
        value
    }

    class SecurityClearance <<Value Object>> {
         level
         expiryDate
    }

    class SkillsAssessment <<Value Object>> {
          assessedAt
          nextDueDate
    }

    User *-- SecurityClearance
    User *-- SkillsAssessment
    User *-- EmailAddress
    User *-- PhoneNumber
}

package "Aircraft Aggregate" {

    class Aircraft <<Aggregate Root>> {
        operationalStatus <<enum>>
        crewSize
    }

    class CabinConfiguration <<Value Object>> {
        economySeats
        businessSeats
        firstClassSeats
    }

    class AircraftRegistration <<Value Object>> {
        value
    }

    class Country <<Value Object>> {
       name
    }

    Aircraft *-- Country
    Aircraft *-- CabinConfiguration
    Aircraft *-- AircraftRegistration


}

package "AircraftModel Aggregate" {

    class AircraftModel <<Aggregate Root>> {
        name
        type <<enum>>
        motorization <<enum>>
        maxRange
        emptyWeight
        MTOW
        MZFW
        maxFuelCapacity
        serviceCeiling
        cruiseSpeed
        wingArea
        dragCoefficient
        liftCoefficient
    }

    class AircraftModelDesignator <<Value Object>> {
        value
    }

    class AircraftVariant <<Entity>> {
        variantId
    }

    AircraftModel *-- AircraftModelDesignator
    AircraftModel *-- AircraftVariant
}


package "EngineModel Aggregate" {

    class EngineModel <<Aggregate Root>> {
        name
        type <<enum>>
        thrust
        fuelType
        TSFC
    }

    class EngineModelDesignator <<Value Object>> {
        value
    }

    EngineModel *-- EngineModelDesignator

}

package "WeatherData Aggregate" {

    class WeatherData <<Aggregate Root>> {
          day
    }

    class WeatherMeasurement <<Value Object>> {
        parameter
        value
        unit
        altitude
    }

    class WeatherProvider <<Entity>> {
        name
        providerType
    }

    class Coordinates <<Value Object>> {
            latitude
            longitude
    }

    WeatherData --> WeatherProvider
    WeatherData *-- WeatherMeasurement
    WeatherMeasurement *-- Coordinates

}

package "Flight Aggregate" {

    class Flight <<Aggregate Root>> {
    }

    class FlightDesignator <<Value Object>> {
        value
    }

    class Departure <<Value Object>> {
        departureDay
        departureTime
    }

    Flight *-- FlightDesignator
    Flight *-- Departure
}

package "Pilot Aggregate" {

    class Pilot <<Aggregate Root>>{
        status <<enum>>
    }

    class PilotID <<Value Object>> {
        value
    }

    class Certification <<Value Object>> {
        issuedAt
        validUntil
    }

    Pilot *-- PilotID
    Pilot *-- Certification

}


package "Manufacturer Aggregate" {

    class Manufacturer <<Aggregate Root>> {
        name
    }

    class ManufacturerDesignator <<Value Object>> {
        value
    }

    class Country <<Value Object>> {
        name
    }

    Manufacturer *-- ManufacturerDesignator
    Manufacturer *-- Country
}



class Collaborator {
    position
}



Simulation "*" --> "*" FlightPlan
Simulation "*" --> "*" WeatherData
Simulation "*" --> "1" AirControlArea

FlightRoute "*" --> "1" Airport : from >
FlightRoute "*" --> "1" Airport : to >
FlightRoute "*" --> "1" AirTransportCompany
FlightRoute "1" --> "0..*" Flight

Flight "1" --> "0..*" FlightPlan

FlightPlan "*" --> "1" Pilot
FlightPlan "*" --> "1" Aircraft
FlightPlan "*" --> "*" WeatherData

Airport "*" --> "1" AirControlArea

WeatherData "*" --> "1" AirControlArea

AircraftVariant "*" --> "1" EngineModel


Aircraft "*" --> "1" AirTransportCompany
Aircraft "*" --> "1" AircraftVariant


Collaborator "*" --> "1" User
Collaborator "*" --> "0..1" AirTransportCompany
Collaborator "*" --> "0..1" AirControlArea

Pilot "*" --> "1" User
Pilot "*" --> "1" AirTransportCompany
Pilot "*" --> "*" AircraftModel

FlightExecution "*" --> "1" FlightPlan


@enduml