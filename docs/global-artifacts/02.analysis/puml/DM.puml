@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods

'title Domain Model

class Simulation <<Aggregate Root>> {
    timeRange
    safetyThreshold
    status
}

class Flight {
    flightDesignator
    type <<enum>>
    departureDay
    departureTime
    scheduledArrival
}

class FlightPlan <<Aggregate Root>> {
    status
}

class FuelQty <<Value Object>> {
    amount
    unit <<enum>>
}

class FlightLeg {
    legNumber
    departureTime
    arrivalTime
}

class Segment {
    windDirection
    windSpeed
}

class AltitudeSlot <<Value Object>> {
    minAltitude
    maxAltitude
    width
}

class FlightRoute <<Aggregate Root>> {
    status <<enum>>
    deactivatedFrom
}

class Airport <<Aggregate Root>> {
    icaoCode
    iataCode
    name
    town
    country
    altitude
}

class AirControlArea <<Aggregate Root>> {
    code
    geographicBoundaries
}

class AirTransportCompany <<Aggregate Root>> {
    name
    iataDesignator
    icaoDesignator
    country
}

class Aircraft <<Aggregate Root>> {
    registrationNumber
    country
    operationalStatus <<enum>>
    crewSize
}

class CabinConfiguration <<Value Object>> {
    economySeats
    businessSeats
    firstClassSeats
}

class Collaborator {
    position
}

class FlightRouteName <<Value Object>> {
    designation
}

class Report {
    totalFlights
    result
    generatedAt
}

class Pilot {
    status <<enum>>
}

class SafetyViolation {
    timestamp
    severity
    type
}

class WeatherData <<Aggregate Root>> {
    day
}

class WeatherMeasurement <<Value Object>> {
    parameter
    value
    unit
}

class WeatherProvider {
    name
    providerType
}

class SystemUser <<Aggregate Root>> {
    email
    name
    phoneNumber
    status <<enum>>
}

class SecurityClearance <<Value Object>> {
    level
    expiryDate
}

class SkillsAssessment <<Value Object>> {
    assessedAt
    nextDueDate
}

class Coordinates <<Value Object>> {
    latitude
    longitude
}

class Manufacturer <<Value Object>> {
    name
    country
}

class AircraftModel <<Aggregate Root>> {
    name
    type <<enum>>
    motorization <<enum>>
    maxRange
    emptyWeight
    MTOW
    MZFW
    maxFuelCapacity
    serviceCeiling
    cruiseSpeed
    wingArea
    dragCoefficient
    liftCoefficient
}

class AircraftVariant {
    variantId
}

class EngineModel <<Aggregate Root>> {
    name
    type <<enum>>
    thrust
    fuelType
    TSFC
}

Simulation "*" --> "*" FlightPlan
Simulation "1" --> "*" Report
Simulation "1" --> "*" SafetyViolation
Simulation "*" --> "*" WeatherData
Simulation "*" --> "1" AirControlArea : geographic area >

FlightRoute "1" --> "*" Flight
FlightRoute "*" --> "1" Airport : from >
FlightRoute "*" --> "1" Airport : to >
FlightRoute "*" --> "1" AirTransportCompany
FlightRoute "1" --> "1" FlightRouteName

Flight "1" --> "*" FlightPlan

FlightPlan "*" --> "1" Pilot
FlightPlan "*" --> "1" Aircraft
FlightPlan "1" --> "*" FlightLeg
FlightPlan "*" --> "*" WeatherData

FlightLeg "1" --> "1" FuelQty : fuel load >
FlightLeg "*" --> "1" Airport : departs from >
FlightLeg "*" --> "1" Airport : arrives at >
FlightLeg "1" --> "*" Segment : composed of >

Segment "1" --> "*" AltitudeSlot
Segment "1" --> "1" Coordinates : start >
Segment "1" --> "1" Coordinates : end >

Airport "*" --> "1" AirControlArea
Airport "1" --> "1" Coordinates

WeatherData "*" --> "1" AirControlArea
WeatherData "*" --> "1" WeatherProvider
WeatherData "1" --> "*" WeatherMeasurement
WeatherMeasurement "1" --> "1" Coordinates

SystemUser "1" --> "1" SecurityClearance : has >
SystemUser "1" --> "1" SkillsAssessment : has >

AircraftModel "1" --> "1" Manufacturer : made by >
AircraftModel "1" --> "*" AircraftVariant
AircraftVariant "*" --> "1" EngineModel

EngineModel "1" --> "1" Manufacturer : made by >

Aircraft "*" --> "1" AirTransportCompany : belongs to >
Aircraft "*" --> "1" AircraftVariant : is of >
Aircraft "1" --> "1" CabinConfiguration

Collaborator "*" --> "1" SystemUser
Collaborator "*" --> "1" AirTransportCompany

Pilot "*" --> "1" SystemUser
Pilot "*" --> "1" AirTransportCompany : belongs to >
Pilot "*" --> "*" AircraftModel : certified for >

@enduml