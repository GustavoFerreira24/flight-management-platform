@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods


class Simulation <<Aggregate Root>> {
    timeRange
    safetyThreshold
    status
}

class FlightPlan <<Aggregate Root>> {
    status
    departureDay
    departureTime
    scheduledArrival
}

class FuelQty <<Value Object>> {
    amount
    unit <<enum>>
}

class FlightLeg {
    legNumber
    departureTime
    arrivalTime
}

class Segment <<Value Object>> {
    windDirection
    windSpeed
}

class AltitudeSlot <<Value Object>> {
    minAltitude
    maxAltitude
    width
}

class FlightRoute <<Aggregate Root>> {
    type <<enum>>
    status <<enum>>
    deactivatedFrom
}

class Airport <<Aggregate Root>> {
    name
    town
    altitude
}

class AirControlArea <<Aggregate Root>> {
}

class AirTransportCompany <<Aggregate Root>> {
    name
}

class Aircraft <<Aggregate Root>> {
    operationalStatus <<enum>>
    crewSize
}

class CabinConfiguration <<Value Object>> {
    economySeats
    businessSeats
    firstClassSeats
}

class Collaborator {
    position
}

class FlightRouteName <<Value Object>> {
    value
}

class FlightDesignator <<Value Object>> {
    value
}

class Report {
    totalFlights
    result
    generatedAt
}

class Pilot {
    status <<enum>>
}

class SafetyViolation {
    timestamp
    severity
    type
}

class WeatherData <<Aggregate Root>> {
    day
}

class WeatherMeasurement <<Value Object>> {
    parameter
    value
    unit
    altitude
}

class WeatherProvider {
    name
    providerType
}

class User <<Aggregate Root>> {
    name
    status <<enum>>
}

class SecurityClearance <<Value Object>> {
    level
    expiryDate
}

class SkillsAssessment <<Value Object>> {
    assessedAt
    nextDueDate
}

class Coordinates <<Value Object>> {
    latitude
    longitude
}

class Manufacturer <<Value Object>> {
    name
}

class Country <<Value Object>> {
    name
}

class IATACode <<Value Object>> {
    value
}

class ICAOCode <<Value Object>> {
    value
}

class AircraftRegistration <<Value Object>> {
    value
}

class EmailAddress <<Value Object>> {
    value
}

class PhoneNumber <<Value Object>> {
    value
}

class AirControlAreaCode <<Value Object>> {
    value
}

class GeographicBoundary <<Value Object>> {
    value
}

class AircraftModel <<Aggregate Root>> {
    name
    type <<enum>>
    motorization <<enum>>
    maxRange
    emptyWeight
    MTOW
    MZFW
    maxFuelCapacity
    serviceCeiling
    cruiseSpeed
    wingArea
    dragCoefficient
    liftCoefficient
}

class AircraftVariant {
    variantId
}

class EngineModel <<Aggregate Root>> {
    name
    type <<enum>>
    thrust
    fuelType
    TSFC
}

class FlightExecution {
    status <<enum>>
}

class AircraftPosition <<Value Object>> {
    altitude
    velocity
    timestamp
}

Simulation "*" --> "*" FlightPlan
Simulation "1" --> "*" Report
Simulation "1" --> "*" SafetyViolation
Simulation "*" --> "*" WeatherData
Simulation "*" --> "1" AirControlArea : geographic area >

FlightRoute "*" --> "1" Airport : from >
FlightRoute "*" --> "1" Airport : to >
FlightRoute "*" --> "1" AirTransportCompany
FlightRoute "1" --> "1" FlightRouteName

FlightPlan "1" --> "1" FlightDesignator
FlightPlan "*" --> "1" Pilot
FlightPlan "*" --> "1" Aircraft
FlightPlan "1" --> "*" FlightLeg
FlightPlan "*" --> "*" WeatherData
FlightPlan "*" --> "1" FlightRoute

FlightLeg "1" --> "1" FuelQty : fuel load >
FlightLeg "*" --> "1" Airport : departs from >
FlightLeg "*" --> "1" Airport : arrives at >
FlightLeg "1" --> "*" Segment : composed of >

Segment "1" --> "*" AltitudeSlot
Segment "1" --> "1" Coordinates : start >
Segment "1" --> "1" Coordinates : end >

Airport "*" --> "1" AirControlArea
Airport "1" --> "1" Coordinates
Airport "1" --> "1" IATACode
Airport "1" --> "1" ICAOCode
Airport "1" --> "1" Country

AirControlArea "1" --> "1" AirControlAreaCode
AirControlArea "1" --> "1" GeographicBoundary

WeatherData "*" --> "1" AirControlArea
WeatherData "*" --> "1" WeatherProvider
WeatherData "1" --> "*" WeatherMeasurement
WeatherMeasurement "1" --> "1" Coordinates

User "1" --> "1" SecurityClearance : has >
User "1" --> "1" SkillsAssessment : has >
User "1" --> "1" EmailAddress
User "1" --> "1" PhoneNumber

AircraftModel "1" --> "1" Manufacturer : made by >
AircraftModel "1" --> "*" AircraftVariant

AircraftVariant "*" --> "1" EngineModel

EngineModel "1" --> "1" Manufacturer : made by >

Aircraft "*" --> "1" AirTransportCompany : belongs to >
Aircraft "*" --> "1" AircraftVariant : is of >
Aircraft "1" --> "1" CabinConfiguration
Aircraft "1" --> "1" AircraftRegistration
Aircraft "1" --> "1" Country

AirTransportCompany "1" --> "1" IATACode
AirTransportCompany "1" --> "1" ICAOCode
AirTransportCompany "1" --> "1" Country

Collaborator "*" --> "1" User
Collaborator "*" --> "0..1" AirTransportCompany
Collaborator "*" --> "0..1" AirControlArea

Pilot "*" --> "1" User
Pilot "*" --> "1" AirTransportCompany : belongs to >
Pilot "*" --> "*" AircraftModel : certified for >

Simulation "1" --> "*" FlightExecution : tracks >
FlightExecution "*" --> "1" FlightPlan : executes >

FlightExecution "1" --> "*" AircraftPosition
AircraftPosition "1" --> "1" Coordinates

SafetyViolation "1" --> "*" AircraftPosition
SafetyViolation "*" --> "*" FlightExecution : involves >

Manufacturer "1" --> "1" Country

@enduml