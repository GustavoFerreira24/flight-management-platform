@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods

'title Domain Model

class FlightPlan {
    flightDesignator
    departureDate
    arrivalDate
    status
}

class FuelQty <<Value Object>> {
        - amount
        - unit <<enum>>
    }

class FlightLeg {

}

class FlightRoute <<Agregate Root>> {
    type
}

class Airport {

}

class AirTransportCompany {

}

class Aircraft {

}

class FlightRouteName <<Value Object>> {

}

class Report {
    tottalFlights
    result
    generateAT
}

class Pilot{

}

class SafetyViolation{
    timestamp
    severity
    type
}

FlightRoute - "1" Airport : for >
FlightRoute - "1" Airport : to >
FlightRoute "*" - "1" AirTransportCompany
FlightRoute - "1" FlightRouteName

FlightPlan - "1" FlightRoute
FlightPlan "*" - "1" Pilot
FlightPlan - "1" Aircraft
FlightPlan "1" - "*" FlightLeg
FlightPlan - "*" FuelQty


@enduml