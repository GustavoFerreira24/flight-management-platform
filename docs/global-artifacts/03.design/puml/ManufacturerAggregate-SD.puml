@startuml
title Manufacturer Aggregate Scenario: Register Manufacturer

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterManufacturerUI" as UI
control ":RegisterManufacturerController" as C
participant "manufacturerRepository\n:ManufacturerRepository" as ManufacturerRepo
participant "manufacturer\n:Manufacturer" as Manufacturer
participant "designator\n:ManufacturerDesignator" as Designator
participant "country\n:Country" as Country
participant "manufacturerType\n:ManufacturerType" as ManufacturerType

BO -> UI : request to register manufacturer
UI -> BO : ask for name, designator, country,\nand manufacturer type

BO -> UI : submit manufacturer data
UI -> C : registerManufacturer(name, designator,\ncountry, manufacturerType)

C -> ManufacturerRepo : existsByDesignator(designator)
ManufacturerRepo --> C : false

C -> Manufacturer ++ : create(name)

Manufacturer -> Designator ++ : create(designator)
Designator --> Manufacturer : designator created

Manufacturer -> Country ++ : create(country)
Country --> Manufacturer : country created

Manufacturer -> ManufacturerType ++ : create(manufacturerType)
ManufacturerType --> Manufacturer : manufacturer type created

Manufacturer --> C : manufacturer created

C -> ManufacturerRepo : save(manufacturer)
ManufacturerRepo --> C : success

C --> UI : manufacturerCreated
UI --> BO : confirm manufacturer registration

@enduml