@startuml
title AirControlArea Aggregate Scenario: Register Air Control Area

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterAirControlAreaUI" as UI
control ":RegisterAirControlAreaController" as C
participant "authz\n:AisafeAuthorizationService" as Authz
participant "airControlAreaRepository\n:AirControlAreaRepository" as AreaRepo
participant "areaCode\n:AirControlAreaCode" as AreaCode
participant "boundary\n:GeographicBoundary" as Boundary
participant "fuelUnit\n:FuelUnit" as FuelUnit
participant "minimumFuelRequirement\n:MinimumFuelRequirement" as FuelRequirement
participant "airControlArea\n:AirControlArea" as Area

BO -> UI : request to register air control area
UI -> BO : ask for area code, name,\ngeographic boundary and minimum fuel

BO -> UI : submit area data
UI -> C : registerAirControlArea(code, name,\nminLatitude, maxLatitude,\nminLongitude, maxLongitude,\nminimumFuelAmount, fuelUnit)

C -> Authz : ensureAuthenticatedUserHasAnyOf\n(BACKOFFICE_CONFIGURATION)
Authz --> C : authorized

C -> AreaCode ++ : valueOf(code)
AreaCode --> C : areaCode

C -> AreaRepo : findByCode(areaCode)
AreaRepo --> C : Optional.empty()

C -> Boundary ++ : valueOf(minLatitude, maxLatitude,\nminLongitude, maxLongitude)
Boundary --> C : geographicBoundary

C -> FuelUnit ++ : valueOf(fuelUnit)
FuelUnit --> C : unit

C -> FuelRequirement ++ : valueOf(minimumFuelAmount, unit)
FuelRequirement --> C : minimumFuelRequirement

C -> Area ++ : new AirControlArea(areaCode, name,\ngeographicBoundary, minimumFuelRequirement)
Area --> C : airControlArea

C -> AreaRepo : save(airControlArea)
AreaRepo --> C : saved airControlArea

C --> UI : airControlArea
UI --> BO : confirm air control area registration

@enduml
