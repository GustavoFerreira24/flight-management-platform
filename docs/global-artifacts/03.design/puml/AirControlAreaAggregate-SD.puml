@startuml
title AirControlArea Aggregate Scenario: Register Air Control Area

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterAirControlAreaUI" as UI
control ":RegisterAirControlAreaController" as C
participant "airControlAreaRepository\n:AirControlAreaRepository" as AreaRepo
participant "airControlArea\n:AirControlArea" as Area
participant "areaCode\n:AirControlAreaCode" as AreaCode
participant "boundary\n:GeographicBoundary" as Boundary

BO -> UI : request to register air control area
UI -> BO : ask for name, area code,\nand geographic boundary

BO -> UI : submit area data
UI -> C : registerAirControlArea(data)

C -> AreaRepo : existsByCode(data.areaCode)
AreaRepo --> C : false

C -> Area ++ : create(data.name)

Area -> AreaCode ++ : create(data.areaCode)
AreaCode --> Area : code created

Area -> Boundary ++ : create(\ndata.minLatitude,\ndata.maxLatitude,\ndata.minLongitude,\ndata.maxLongitude)
Boundary --> Area : boundary created

Area -> Area : validateInvariants()\n- code is unique in the system\n- minLatitude < maxLatitude\n- minLongitude < maxLongitude

C -> AreaRepo : save(area)
AreaRepo --> C : success

C --> UI : airControlAreaCreated
UI --> BO : confirm air control area registration

@enduml