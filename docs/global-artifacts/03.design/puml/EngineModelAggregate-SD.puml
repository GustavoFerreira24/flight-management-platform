@startuml
title EngineModel Aggregate Scenario: Register Engine Model

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterEngineModelUI" as UI
control ":RegisterEngineModelController" as C
participant "engineModelRepository\n:EngineModelRepository" as EngineRepo
participant "engineModel\n:EngineModel" as EngineModel
participant "designator\n:EngineModelDesignator" as Designator

BO -> UI : request to register engine model
UI -> BO : ask for name, type,\nthrust, fuel type, TSFC, designator

BO -> UI : submit engine model data
UI -> C : registerEngineModel(data)

C -> EngineRepo : existsByDesignator(data.designator)
EngineRepo --> C : false

C -> EngineModel ++ : create(data.name, data.type,\ndata.thrust, data.fuelType, data.TSFC)

EngineModel -> Designator ++ : create(data.designator)
Designator --> EngineModel : designator created

EngineModel -> EngineModel : validateInvariants()\n- thrust > 0\n- TSFC > 0\n- type is defined\n- fuel type is defined

C -> EngineRepo : save(engineModel)
EngineRepo --> C : success

C --> UI : engineModelCreated
UI --> BO : confirm engine model registration

@enduml