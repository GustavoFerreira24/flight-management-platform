@startuml
title FlightRoute Aggregate Scenario: Deactivate Flight Route

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "ATC Collaborator" as ATC
boundary ":ManageFlightRouteUI" as UI
control ":ManageFlightRouteController" as C
participant "flightRouteRepository\n:FlightRouteRepository" as RouteRepo
participant "flightRoute\n:FlightRoute" as Route

ATC -> UI : request to deactivate flight route
UI -> ATC : ask for route identifier\nand deactivation date

ATC -> UI : submit routeId and date
UI -> C : deactivateRoute(routeId, date)

C -> RouteRepo : findById(routeId)
RouteRepo --> C : flightRoute

C -> Route : deactivateFrom(date)

activate Route

Route -> Route : validateDeactivationDate(date)\n- date must be in the future
Route -> Route : ensureRouteIsActive()
Route -> FlightRouteStatus ++ : create(INACTIVE)
FlightRouteStatus --> Route : status updated
Route -> Route : setDeactivatedFrom(date)

deactivate Route

C -> RouteRepo : save(route)
RouteRepo --> C : success

C --> UI : routeDeactivated
UI --> ATC : confirm route deactivation

@enduml