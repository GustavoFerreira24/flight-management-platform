@startuml
title User Aggregate Scenario: Activate User

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Administrator" as Admin
boundary ":ManageUserUI" as UI
control ":ManageUserController" as C
participant "userRepository\n:UserRepository" as UserRepo
participant "user\n:User" as User

Admin -> UI : request to activate user
UI -> Admin : ask for user identifier

Admin -> UI : submit user identifier
UI -> C : activateUser(userId)

C -> UserRepo : findById(userId)
UserRepo --> C : user

C -> User : activate()

activate User

User -> User : ensureSecurityClearanceIsValid()\n- current date <= expiryDate
User -> User : ensureSkillsAssessmentIsUpToDate()\n- current date <= nextDueDate
User -> User : setStatus(ACTIVE)

deactivate User

C -> UserRepo : save(user)
UserRepo --> C : success

C --> UI : userActivated
UI --> Admin : confirm user activation

@enduml