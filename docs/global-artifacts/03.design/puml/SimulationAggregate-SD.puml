@startuml
title Simulation Aggregate Scenario: Execute Simulation and Integrate Results

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam responseMessageBelowArrow true
autonumber

actor "Flight Control Operator" as FCO
boundary ":RunSimulationUI" as UI
control ":RunSimulationController" as C
participant "simulationRepo\n:SimulationRepository" as SimRepo
participant "flightPlanRepo\n:FlightPlanRepository" as FPRepo
participant "aircraftRepo\n:AircraftRepository" as ARepo
participant "weatherDataRepo\n:WeatherDataRepository" as WRepo
participant "<<external>>\n:CSimulationModule" as CSim
participant "simulation\n:Simulation" as Sim
participant "report\n:SimulationReport" as Report

FCO -> UI : request simulation execution
UI -> C : executeSimulation(simulationId)

C -> SimRepo : findById(simulationId)
SimRepo --> C : simulation

C -> FPRepo : findIncludedFlightPlans(simulation)
FPRepo --> C : flightPlans

C -> ARepo : findAircraftFor(flightPlans)
ARepo --> C : aircraft

C -> WRepo : findByAreaAndTimeRange(\nsimulation.area, simulation.timeRange)
WRepo --> C : weatherData

C -> CSim : runSimulation(\nsimulation.parameters,\nflightPlans,\naircraft,\nweatherData)
activate CSim
CSim --> C : simulationResults
deactivate CSim

C -> Sim : concludeWith(simulationResults)
activate Sim
Sim -> Sim : recordFlightExecutions(...)
Sim -> Sim : recordSafetyViolations(...)
Sim -> Report ++ : generate from flight executions and violations
Report --> Sim : simulation report
Sim -> Sim : validateInvariants()
deactivate Sim

C -> SimRepo : save(simulation)
SimRepo --> C : success

C --> UI : simulationConcluded(reportSummary)
UI --> FCO : display report summary

@enduml
