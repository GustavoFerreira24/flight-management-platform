@startuml
title AircraftModel Aggregate Scenario: Add Certified Variant to Aircraft Model

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":ManageAircraftModelUI" as UI
control ":ManageAircraftModelController" as C
participant "aircraftModelRepository\n:AircraftModelRepository" as AircraftModelRepo
participant "engineModelRepository\n:EngineModelRepository" as EngineModelRepo
participant "aircraftModel\n:AircraftModel" as AircraftModel
participant "engineModel\n:EngineModel" as EngineModel
participant "aircraftVariant\n:AircraftVariant" as AircraftVariant

BO -> UI : request to add certified variant
UI -> BO : ask for aircraft model and engine model

BO -> UI : submit aircraftModelId and engineModelId
UI -> C : addCertifiedVariant(aircraftModelId, engineModelId)

C -> AircraftModelRepo : findById(aircraftModelId)
AircraftModelRepo --> C : aircraftModel

C -> EngineModelRepo : findById(engineModelId)
EngineModelRepo --> C : engineModel

C -> AircraftModel : addVariant(engineModel)
activate AircraftModel

AircraftModel -> AircraftModel : ensureEngineModelNotDuplicated(engineModel)
AircraftModel -> AircraftModel : ensureEngineTypeCompatibility(engineModel)
AircraftModel -> AircraftVariant ++ : create(engineModel)
AircraftVariant --> AircraftModel : variant created
AircraftModel -> AircraftModel : ensureAtLeastOneCertifiedVariant()

deactivate AircraftModel

C -> AircraftModelRepo : save(aircraftModel)
AircraftModelRepo --> C : success

C --> UI : variantAdded
UI --> BO : confirm certified variant addition

@enduml