@startuml
title Aircraft Aggregate Scenario: Register Aircraft in Company Fleet

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "ATC Collaborator" as ATC
boundary ":RegisterAircraftUI" as UI
control ":RegisterAircraftController" as C
participant "authz\n:AisafeAuthorizationService" as Authz
participant "customerCollaboratorRepository\n:CustomerCollaboratorRepository" as CollaboratorRepo
participant "airTransportCompanyRepository\n:AirTransportCompanyRepository" as CompanyRepo
participant "aircraftRepository\n:AircraftRepository" as AircraftRepo
participant "aircraftModelRepository\n:AircraftModelRepository" as AircraftModelRepo
participant "engineModelRepository\n:EngineModelRepository" as EngineModelRepo
participant "aircraftVariantService\n:AircraftVariantService" as VariantService
participant "registration\n:AircraftRegistration" as Registration
participant "aircraftModelDesignator\n:AircraftModelDesignator" as AircraftModelDesignator
participant "engineModelDesignator\n:EngineModelDesignator" as EngineModelDesignator
participant "company\n:AirTransportCompany" as Company
participant "aircraftModel\n:AircraftModel" as AircraftModel
participant "engineModel\n:EngineModel" as EngineModel
participant "registrationCountry\n:AircraftRegistrationCountry" as RegistrationCountry
participant "cabinConfiguration\n:CabinConfiguration" as CabinConfiguration
participant "status\n:AircraftOperationalStatus" as Status
participant "aircraft\n:Aircraft" as Aircraft

ATC -> UI : request to register aircraft
UI -> ATC : ask for registration, country, status,\ncrew size, cabin configuration,\naircraft model and certified engine model

ATC -> UI : submit aircraft data
UI -> C : registerAircraft(registration, country, status,\ncrewSize, economySeats, businessSeats, firstClassSeats,\naircraftModelName, aircraftModelManufacturer,\nengineModelName, engineModelManufacturer)

C -> Authz : ensureAuthenticatedUserHasAnyOf\n(AIR_COMPANY_CONFIGURATION)
Authz --> C : authorized

C -> Registration ++ : valueOf(registration)
Registration --> C : aircraftRegistration

C -> AircraftRepo : findByRegistration(aircraftRegistration)
AircraftRepo --> C : Optional.empty()

C -> Authz : authenticatedUsername()
Authz --> C : username

C -> CollaboratorRepo : findBySystemUsername(systemUsername)
CollaboratorRepo --> C : customerCollaborator

C -> CompanyRepo : findByIataCode(companyIataCode)
CompanyRepo --> C : company

C -> AircraftModelDesignator ++ : valueOf(aircraftModelName,\naircraftModelManufacturer)
AircraftModelDesignator --> C : aircraftModelDesignator

C -> AircraftModelRepo : findByDesignator(aircraftModelDesignator)
AircraftModelRepo --> C : aircraftModel

C -> EngineModelDesignator ++ : valueOf(engineModelName,\nengineModelManufacturer)
EngineModelDesignator --> C : engineModelDesignator

C -> EngineModelRepo : findByDesignator(engineModelDesignator)
EngineModelRepo --> C : engineModel

C -> VariantService : ensureCertifiedVariant(aircraftModel, engineModel)
VariantService --> C : certified variant accepted

C -> RegistrationCountry ++ : valueOf(country)
RegistrationCountry --> C : registrationCountry

C -> CabinConfiguration ++ : valueOf(economySeats,\nbusinessSeats, firstClassSeats)
CabinConfiguration --> C : cabinConfiguration

C -> Status ++ : valueOf(status)
Status --> C : operationalStatus

C -> Aircraft ++ : new Aircraft(aircraftRegistration,\nregistrationCountry, cabinConfiguration, operationalStatus,\ncrewSize, company, aircraftModel, engineModel)
Aircraft --> C : aircraft

C -> AircraftRepo : save(aircraft)
AircraftRepo --> C : saved aircraft

C --> UI : aircraft
UI --> ATC : confirm aircraft registration

@enduml
