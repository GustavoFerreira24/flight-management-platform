@startuml
title AirTransportCompany Aggregate Scenario: Register Air Transport Company

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterAirTransportCompanyUI" as UI
control ":RegisterAirTransportCompanyController" as C
participant "airTransportCompanyRepository\n:AirTransportCompanyRepository" as CompanyRepo
participant "airTransportCompany\n:AirTransportCompany" as Company
participant "country\n:Country" as Country
participant "iataCode\n:IATACode" as IATACode
participant "icaoCode\n:ICAOCode" as ICAOCode

BO -> UI : request to register air transport company
UI -> BO : ask for name, country,\nIATA code and ICAO code

BO -> UI : submit company data
UI -> C : registerAirTransportCompany(data)

C -> CompanyRepo : existsByIATACode(data.iataCode)
CompanyRepo --> C : false

C -> CompanyRepo : existsByICAOCode(data.icaoCode)
CompanyRepo --> C : false

C -> Company ++ : create(data.name)

Company -> Country ++ : create(data.country)
Country --> Company : country created

Company -> IATACode ++ : create(data.iataCode)
IATACode --> Company : IATA code created

Company -> ICAOCode ++ : create(data.icaoCode)
ICAOCode --> Company : ICAO code created

Company -> Company : validateInvariants()\n- exactly one country exists\n- exactly one IATA code exists\n- exactly one ICAO code exists

C -> CompanyRepo : save(company)
CompanyRepo --> C : success

C --> UI : airTransportCompanyCreated
UI --> BO : confirm company registration

@enduml