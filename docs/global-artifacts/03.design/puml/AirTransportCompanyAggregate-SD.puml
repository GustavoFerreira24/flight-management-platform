@startuml
title AirTransportCompany Aggregate Scenario: Register Air Transport Company

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterAirTransportCompanyUI" as UI
control ":AirCompanyConfigurationController" as C
participant "authz\n:AisafeAuthorizationService" as Authz
participant "airTransportCompanyRepository\n:AirTransportCompanyRepository" as CompanyRepo
participant "country\n:Country" as Country
participant "iataCode\n:IATACode" as IATACode
participant "icaoCode\n:ICAOCode" as ICAOCode
participant "airTransportCompany\n:AirTransportCompany" as Company

BO -> UI : request to register air transport company
UI -> BO : ask for name, country,\nIATA code, and ICAO code

BO -> UI : submit company data
UI -> C : registerAirTransportCompany(name, country,\niataCode, icaoCode)

C -> Authz : ensureAuthenticatedUserHasAnyOf\n(BACKOFFICE_CONFIGURATION)
Authz --> C : authorized

C -> Country ++ : valueOf(country)
Country --> C : companyCountry

C -> IATACode ++ : valueOf(iataCode)
IATACode --> C : companyIataCode

C -> ICAOCode ++ : valueOf(icaoCode)
ICAOCode --> C : companyIcaoCode

C -> CompanyRepo : findByIataCode(companyIataCode)
CompanyRepo --> C : Optional.empty()

C -> CompanyRepo : findByIcaoCode(companyIcaoCode)
CompanyRepo --> C : Optional.empty()

C -> Company ++ : new AirTransportCompany(name,\ncompanyCountry, companyIataCode, companyIcaoCode)
Company --> C : airTransportCompany

C -> CompanyRepo : save(airTransportCompany)
CompanyRepo --> C : saved airTransportCompany

C --> UI : airTransportCompany
UI --> BO : confirm company registration

@enduml
