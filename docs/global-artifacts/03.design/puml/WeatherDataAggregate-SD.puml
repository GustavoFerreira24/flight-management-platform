@startuml
title WeatherData Aggregate Scenario: Register Weather Measurement

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Weather Person" as WP
boundary ":RegisterWeatherDataUI" as UI
control ":RegisterWeatherDataController" as C
participant "weatherDataRepository\n:WeatherDataRepository" as WeatherRepo
participant "weatherProviderRepository\n:WeatherProviderRepository" as ProviderRepo
participant "weatherData\n:WeatherData" as WeatherData
participant "weatherMeasurement\n:WeatherMeasurement" as Measurement
participant "coordinates\n:Coordinates" as Coordinates

WP -> UI : request to register weather data
UI -> WP : ask for day, air control area,\nprovider, parameter, value,\nunit, altitude and coordinates

WP -> UI : submit weather data
UI -> C : registerWeatherMeasurement(data, providerId, areaId)

C -> ProviderRepo : findById(providerId)
ProviderRepo --> C : provider

C -> WeatherRepo : findByDayAndArea(data.day, areaId)
WeatherRepo --> C : weatherData

alt weather data already exists for day and area
    C -> WeatherData : addMeasurement(data, provider)

    activate WeatherData
    WeatherData -> Measurement ++ : create(data.parameter,\ndata.value, data.unit,\ndata.altitude, provider)
    Measurement -> Coordinates ++ : create(data.latitude, data.longitude)
    Coordinates --> Measurement : coordinates created
    Measurement --> WeatherData : measurement created

    WeatherData -> WeatherData : validateInvariants()\n- all measurements belong to same day\n- all measurements belong to same area\n- measurement data is valid
    deactivate WeatherData

else no weather data exists for day and area
    C -> WeatherData ++ : create(data.day, areaId)
    C -> WeatherData : addMeasurement(data, provider)

    activate WeatherData
    WeatherData -> Measurement ++ : create(data.parameter,\ndata.value, data.unit,\ndata.altitude, provider)
    Measurement -> Coordinates ++ : create(data.latitude, data.longitude)
    Coordinates --> Measurement : coordinates created
    Measurement --> WeatherData : measurement created

    WeatherData -> WeatherData : validateInvariants()\n- all measurements belong to same day\n- all measurements belong to same area\n- measurement data is valid
    deactivate WeatherData
end

C -> WeatherRepo : save(weatherData)
WeatherRepo --> C : success

C --> UI : weatherDataRegistered
UI --> WP : confirm weather data registration

@enduml