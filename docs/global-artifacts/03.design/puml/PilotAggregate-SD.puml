@startuml
title US11 - Pilot Aggregate Scenario: Activate Pilot with Valid Certification

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "ATC Collaborator" as ATC
boundary ":ManagePilotUI" as UI
control ":ManagePilotController" as C
participant "pilotRepository\n:PilotRepository" as PilotRepo
participant "pilot\n:Pilot" as Pilot
participant "certification\n:Certification" as Certification

ATC -> UI : request to activate pilot
UI -> ATC : ask for pilotId

ATC -> UI : submit pilotId
UI -> C : activatePilot(pilotId)

C -> PilotRepo : findById(pilotId)
PilotRepo --> C : pilot

C -> Pilot : activate()

activate Pilot

Pilot -> Pilot : ensureCertificationIsValid()\n- current date < validUntil
Pilot -> PilotStatus ++ : create(ACTIVE)
PilotStatus --> Pilot : status updated

deactivate Pilot

C -> PilotRepo : save(pilot)
PilotRepo --> C : success

C --> UI : pilotActivated
UI --> ATC : confirm pilot activation

@enduml