@startuml
title Airport Aggregate Scenario: Register Airport

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterAirportUI" as UI
control ":RegisterAirportController" as C
participant "airportRepository\n:AirportRepository" as AirportRepo
participant "airControlAreaRepository\n:AirControlAreaRepository" as AreaRepo
participant "airControlArea\n:AirControlArea" as Area
participant "airport\n:Airport" as Airport
participant "coordinates\n:Coordinates" as Coordinates
participant "country\n:Country" as Country
participant "iataCode\n:IATACode" as IATACode
participant "icaoCode\n:ICAOCode" as ICAOCode

BO -> UI : request to register airport
UI -> BO : ask for name, town, country,\ncoordinates, altitude, IATA code,\nICAO code, and air control area

BO -> UI : submit airport data
UI -> C : registerAirport(name, town, country,\nlatitude, longitude, altitude,\niataCode, icaoCode, airControlAreaCode)

C -> AirportRepo : existsByIATACode(iataCode)
AirportRepo --> C : false

C -> AirportRepo : existsByICAOCode(icaoCode)
AirportRepo --> C : false

C -> AreaRepo : findByCode(airControlAreaCode)
AreaRepo --> C : airControlArea

C -> Airport ++ : create(name, town, altitude, airControlArea)

Airport -> Country ++ : create(country)
Country --> Airport : country created

Airport -> Coordinates ++ : create(latitude, longitude)
Coordinates --> Airport : coordinates created

Airport -> IATACode ++ : create(iataCode)
IATACode --> Airport : IATA code created

Airport -> ICAOCode ++ : create(icaoCode)
ICAOCode --> Airport : ICAO code created

Airport -> Airport : validateInternalInvariants()\n- coordinates are valid
Airport --> C : airport created

C -> AirportRepo : save(airport)
AirportRepo --> C : success

C --> UI : airportCreated
UI --> BO : confirm airport registration

@enduml