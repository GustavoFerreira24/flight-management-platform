@startuml
title Airport Aggregate - Register Airport

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Backoffice Operator" as BO
boundary ":RegisterAirportUI" as UI
control ":RegisterAirportController" as Controller
participant ":AirportRepository" as AirportRepo
participant ":AirControlAreaRepository" as AreaRepo

participant ":Airport" as Airport
participant ":IATACode" as IATACode
participant ":ICAOCode" as ICAOCode
participant ":Country" as Country
participant ":GpsCoordinates" as Coordinates
participant ":Elevation" as Elevation
participant ":AirControlArea" as Area

BO -> UI : request to register airport

UI -> BO : ask for IATA Code, ICAO Code, Name, City, Country,\nLatitude, Longitude, Elevation, Air Control Area Code

BO -> UI : submit data

UI -> Controller : registerAirport(iataCode, icaoCode, name, city, country,\nlatitude, longitude, elevation, areaCode)

== Validation ==

Controller -> IATACode ++ : valueOf(icaoCode)
IATACode --> Controller : icaoCode

Controller -> AirportRepo : ofIdentity(icaoCode)
AirportRepo --> AirportRepo : isPresent()

AirportRepo --> Controller : empty

Controller -> IATACode ++ : valueOf(iataCode)
IATACode --> Controller : iataCode

Controller -> AirportRepo : findByIataCode(iataCode)
AirportRepo --> AirportRepo : isPresent()

AirportRepo --> Controller : empty

== Air Control Area Validation ==

Controller -> AreaCode ++ : valueOf(areaCode)
AreaCode --> Controller : areaCode

Controller -> AreaRepo : ofIdentity(areaCode)
AreaRepo --> Controller : airControlArea

== Domain Object Creation ==

Controller -> Airport ++ : create(iataCode, icaoCode, name, city, country, \nlatitude, longitude, elevation, airControlArea)

    Airport -> IATACode ++ : AirportIATACode(iataCode)
    IATACode --> Airport : iataCode

    Airport -> ICAOCode ++ : AirportICAOCode(icaoCode)
    ICAOCode --> Airport : icaoCode

    Airport -> Country ++ : Country(country)
    Country --> Airport : country

    Airport -> Coordinates ++ : GpsCoordinates(latitude, longitude)
    Coordinates --> Airport : coordinates

    Airport -> Elevation ++ : create(elevation)
    Elevation --> Airport : elevation

    Airport -> Airport : validate()

Airport --> Controller : airport

== Persistence ==

Controller -> AirportRepo : save(airport)
AirportRepo --> Controller : success

Controller --> UI : success
UI --> BO : "Airport registered successfully"

@enduml