@startuml
title FlightPlan Aggregate Scenario: Create Flight Plan

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Pilot" as P
boundary ":CreateFlightPlanUI" as UI
control ":CreateFlightPlanController" as C
participant "flightRepository\n:FlightRepository" as FlightRepo
participant "aircraftRepository\n:AircraftRepository" as AircraftRepo
participant "pilotRepository\n:PilotRepository" as PilotRepo
participant "flightPlanRepository\n:FlightPlanRepository" as FlightPlanRepo
participant "flight\n:Flight" as Flight
participant "aircraft\n:Aircraft" as Aircraft
participant "pilot\n:Pilot" as Pilot
participant "flightPlan\n:FlightPlan" as FlightPlan
participant "flightPlanStatus\n:FlightPlanStatus" as FlightPlanStatus
participant "fuelQty\n:FuelQty" as FuelQty
participant "fuelUnit\n:FuelUnit" as FuelUnit

P -> UI : request to create flight plan
UI -> P : ask for flight, aircraft,\nplanned departure, scheduled arrival,\nfuel quantity, and fuel unit

P -> UI : submit flight plan data
UI -> C : createFlightPlan(flightId, aircraftId, pilotId,\nplannedDeparture, scheduledArrival,\nfuelAmount, fuelUnit)

C -> FlightRepo : findById(flightId)
FlightRepo --> C : flight

C -> AircraftRepo : findById(aircraftId)
AircraftRepo --> C : aircraft

C -> PilotRepo : findById(pilotId)
PilotRepo --> C : pilot

C -> FlightPlan ++ : create(flight, aircraft, pilot,\nplannedDeparture, scheduledArrival)

FlightPlan -> FlightPlanStatus ++ : create(DRAFT)
FlightPlanStatus --> FlightPlan : status created

FlightPlan -> FuelQty ++ : create(fuelAmount)
FuelQty --> FlightPlan : fuel quantity created

FuelQty -> FuelUnit ++ : create(fuelUnit)
FuelUnit --> FuelQty : fuel unit created

FlightPlan -> FlightPlan : validateInternalInvariants()\n- fuel quantity > 0\n- initial status is valid
FlightPlan --> C : flight plan created

C -> FlightPlanRepo : save(flightPlan)
FlightPlanRepo --> C : success

C --> UI : flightPlanCreated
UI --> P : confirm flight plan creation

@enduml