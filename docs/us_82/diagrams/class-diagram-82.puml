@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

class InsertWeatherDataInFlightPlanController <<Controller>> {
    - authz : AisafeAuthorizationService
    - flightPlanRepository : FlightPlanRepository
    - weatherDataRepository : WeatherDataRepository
    + execute() : void
    + insertWeatherData(flightPlanIdentifier : String, weatherDataDay : String, airControlAreaCode : String) : FlightPlan
    - ensureFlightPlanBelongsToAuthenticatedPilot(flightPlan : FlightPlan) : void
    - parseDay(weatherDataDay : String) : LocalDate
    - ensureNotBlank(value : String, message : String) : void
    - flightPlanRepository() : FlightPlanRepository
    - weatherDataRepository() : WeatherDataRepository
}

class AisafeAuthorizationService <<Service>> {
    + ensureAuthenticatedUserHasAnyOf(actions : Role[]) : void
    + authenticatedUsername() : String
    + authenticatedEmail() : String
}

class AisafePermissions <<Permissions>> {
    + {static} FLIGHT_PLAN_WEATHER_DATA_INSERTION : Role[]
}

interface FlightPlanRepository {
    + findByIdentifier(identifier : FlightPlanIdentifier) : Optional<FlightPlan>
    + findByDepartureBetween(startInclusive : LocalDateTime, endExclusive : LocalDateTime) : Iterable<FlightPlan>
    + save(flightPlan : FlightPlan) : FlightPlan
}

class InMemoryFlightPlanRepository <<Test Repository>>
class JpaFlightPlanRepository <<Repository>>

interface WeatherDataRepository {
    + findByDayAndAirControlArea(day : LocalDate, code : AirControlAreaCode) : Optional<WeatherData>
}

class FlightPlan <<Aggregate Root>> {
    - identifier : FlightPlanIdentifier
    - flight : Flight
    - aircraft : Aircraft
    - pilot : Pilot
    - fuelQuantity : FuelQuantity
    - status : FlightPlanStatus
    - weatherDataIds : List<WeatherDataId>
    + addWeatherData(weatherData : WeatherData) : void
    + markUnderValidation() : void
    + validate() : void
    + reject() : void
    + pilot() : Pilot
    + status() : FlightPlanStatus
    + weatherDataIds() : List<WeatherDataId>
}

class FlightPlanIdentifier <<Value Object>>
class Flight <<Aggregate Root>>
class Aircraft <<Aggregate Root>>
class Pilot <<Aggregate Root>> {
    + identity() : PilotID
}
class PilotID <<Value Object>>
class FuelQuantity <<Value Object>>
enum FlightPlanStatus {
    DRAFT
    UNDER_VALIDATION
    VALIDATED
    REJECTED
}

class WeatherData <<Aggregate Root>> {
    + identity() : WeatherDataId
    + day() : LocalDate
    + airControlAreaCode() : AirControlAreaCode
}

class WeatherDataId <<Value Object>>
class AirControlAreaCode <<Value Object>>

InsertWeatherDataInFlightPlanController --> AisafeAuthorizationService
InsertWeatherDataInFlightPlanController --> AisafePermissions
InsertWeatherDataInFlightPlanController --> FlightPlanRepository
InsertWeatherDataInFlightPlanController --> WeatherDataRepository
InsertWeatherDataInFlightPlanController --> FlightPlanIdentifier
InsertWeatherDataInFlightPlanController --> AirControlAreaCode
InsertWeatherDataInFlightPlanController --> FlightPlan
InsertWeatherDataInFlightPlanController --> WeatherData
InsertWeatherDataInFlightPlanController --> PilotID

InMemoryFlightPlanRepository ..|> FlightPlanRepository
JpaFlightPlanRepository ..|> FlightPlanRepository
FlightPlanRepository --> FlightPlan
WeatherDataRepository --> WeatherData

FlightPlan *-- FlightPlanIdentifier
FlightPlan --> Flight
FlightPlan --> Aircraft
FlightPlan --> Pilot
FlightPlan *-- FuelQuantity
FlightPlan *-- FlightPlanStatus
FlightPlan "1" *-- "0..*" WeatherDataId
Pilot *-- PilotID
WeatherData *-- WeatherDataId
WeatherData *-- AirControlAreaCode

@enduml
