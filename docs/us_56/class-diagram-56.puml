@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

class RegisterEngineModelUI <<UI>> {
    + show() : void
}

class RegisterEngineModelController <<Controller>> {
    + registerEngineModel(...) : EngineModel
}

class EngineModel <<Aggregate Root>> {
    - designator : EngineModelDesignator
    - manufacturer : Manufacturer
    - engineType : EngineType
    - fuelType : FuelType
    - power : double
    - thrust : double
    - tsfc : double
    + identity() : EngineModelDesignator
}

class EngineModelDesignator <<Value Object>> {
    + valueOf(modelName : String, manufacturer : String) : EngineModelDesignator
}

class EngineType <<Value Object>>
class FuelType <<Value Object>>
class Manufacturer <<Aggregate Root>> {
    - designator : ManufacturerDesignator
    - type : ManufacturerType
    + canManufactureEngineModels() : boolean
}
class ManufacturerDesignator <<Value Object>>
class ManufacturerType <<Value Object>>
interface EngineModelRepository
interface ManufacturerRepository

RegisterEngineModelUI --> RegisterEngineModelController
RegisterEngineModelController --> EngineModelRepository
RegisterEngineModelController --> ManufacturerRepository
RegisterEngineModelController --> EngineModel

EngineModel *-- EngineModelDesignator
EngineModel --> Manufacturer
EngineModel *-- EngineType
EngineModel *-- FuelType
Manufacturer *-- ManufacturerDesignator
Manufacturer *-- ManufacturerType

@enduml
